# Port nadawany automatycznie przez Railway
PORT=3000
# Połączenie z PostgreSQL (na Railway: ${{Postgres.DATABASE_URL}}). Bez tej zmiennej zapis idzie do plików w ./data
DATABASE_URL=
# Sekret do podpisywania tokenów logowania (na Railway: ${{secret(48)}})
JWT_SECRET=
# Hasło administratora: w grze wpisz /admin <hasło>
ADMIN_PASSWORD=
# Limity
MAX_PLAYERS_PER_WORLD=6
MAX_ACTIVE_WORLDS=12
# Katalog zapisu, gdy nie ma DATABASE_URL
DATA_DIR=./data
